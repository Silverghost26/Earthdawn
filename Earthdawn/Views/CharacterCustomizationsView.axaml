<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Earthdawn.ViewModels"
             xmlns:models="clr-namespace:Earthdawn.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:CharacterCustomizationsViewModel"
             x:Class="Earthdawn.Views.CharacterCustomizationsView">
    
    <Design.DataContext><vm:HomeViewModel></vm:HomeViewModel></Design.DataContext>
    <StackPanel Spacing="5" Width="1900">
        <Border Classes="background" CornerRadius="30" Padding="20">
            <StackPanel Spacing="5">
                <Label Classes="PrimarySubHeader" Content="Attributes" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                <Grid ColumnDefinitions="Auto,Auto,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="2">
                        <Label Classes="PrimaryText" Content="Remaining Attribute Points:" Padding="20 0 5 10" FontSize="30"/>
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding RemainingAttributePoints}" 
                                   FontSize="30" Padding="5 0 0 0" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding Dexterity, StringFormat='Dexterity:     {0}'}" FontSize="20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="TextureButton" 
                                    Content="{Binding DexDecrementCost, StringFormat='{}Refund&#x0a;{0}'}" 
                                    FontSize="10"
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding DecrementAttributeCommand}" CommandParameter="Dexterity"/>
                            <Button Classes="TextureButton"
                                    FontSize="10"
                                    Content="{Binding DexIncrementCost, StringFormat='{}Cost&#x0a;{0}'}" 
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding IncrementAttributeCommand}" CommandParameter="Dexterity"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding Strength, StringFormat='Strength:      {0}'}" FontSize="20" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="TextureButton" 
                                    Content="{Binding StrDecrementCost, StringFormat='{}Refund&#x0a;{0}'}" 
                                    FontSize="10"
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding DecrementAttributeCommand}" CommandParameter="Strength"/>
                            <Button Classes="TextureButton"
                                    FontSize="10"
                                    Content="{Binding StrIncrementCost, StringFormat='{}Cost&#x0a;{0}'}" 
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding IncrementAttributeCommand}" CommandParameter="Strength"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding Toughness, StringFormat='Toughness:  {0}'}" FontSize="20" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="TextureButton" 
                                    Content="{Binding TouDecrementCost, StringFormat='{}Refund&#x0a;{0}'}" 
                                    FontSize="10"
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding DecrementAttributeCommand}" CommandParameter="Toughness"/>
                            <Button Classes="TextureButton"
                                    FontSize="10"
                                    Content="{Binding TouIncrementCost, StringFormat='{}Cost&#x0a;{0}'}" 
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding IncrementAttributeCommand}" CommandParameter="Toughness"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding Perception, StringFormat='Perception:   {0} '}" FontSize="20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="TextureButton" 
                                    Content="{Binding PerDecrementCost, StringFormat='{}Refund&#x0a;{0}'}" 
                                    FontSize="10"
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding DecrementAttributeCommand}" CommandParameter="Perception"/>
                            <Button Classes="TextureButton"
                                    FontSize="10"
                                    Content="{Binding PerIncrementCost, StringFormat='{}Cost&#x0a;{0}'}" 
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding IncrementAttributeCommand}" CommandParameter="Perception"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding Willpower, StringFormat='Willpower:   {0}'}" FontSize="20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="TextureButton" 
                                    Content="{Binding WilDecrementCost, StringFormat='{}Refund&#x0a;{0}'}" 
                                    FontSize="10"
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding DecrementAttributeCommand}" CommandParameter="Willpower"/>
                            <Button Classes="TextureButton"
                                    FontSize="10"
                                    Content="{Binding WilIncrementCost, StringFormat='{}Cost&#x0a;{0}'}" 
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding IncrementAttributeCommand}" CommandParameter="Willpower"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center">
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding Charisma, StringFormat='Charisma:    {0}'}" FontSize="20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="TextureButton" 
                                    Content="{Binding ChrDecrementCost, StringFormat='{}Refund&#x0a;{0}'}" 
                                    FontSize="10"
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding DecrementAttributeCommand}" CommandParameter="Charisma"/>
                            <Button Classes="TextureButton"
                                    FontSize="10"
                                    Content="{Binding ChrIncrementCost, StringFormat='{}Cost&#x0a;{0}'}" 
                                    Width="75" Height="56" 
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    TextBlock.TextAlignment="Center"
                                    Command="{Binding IncrementAttributeCommand}" CommandParameter="Charisma"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Top" BorderBrush="Black" BorderThickness="2" CornerRadius="25">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Label Classes="PrimaryText" 
                                       Content="{Binding RacialKarma, StringFormat='Starting Karma: ({0})'}" 
                                       FontSize="25" Padding="10 0 5 10"/>
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding Karma}" 
                                           FontSize="25"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding Initiative, StringFormat='Initiative: {0}'}" 
                                           FontSize="25" Padding="10 0 5 10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Row="1" Grid.Column="3" Grid.RowSpan="3" 
                            VerticalAlignment="Top" 
                            BorderBrush="Black" BorderThickness="2" CornerRadius="25">
                        <StackPanel  Orientation="Vertical"  HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding PhysicalDefense, StringFormat='PhysicalDefense:       {0}'}" 
                                           FontSize="25" Padding="10 0 5 10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding MysticDefense, StringFormat='MysticDefense:          {0}'}" 
                                           FontSize="25" Padding="10 0 5 10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding SocialDefense, StringFormat='SocialDefense:          {0}'}" 
                                           FontSize="25" Padding="10 0 5 10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="4" Grid.RowSpan="3" BorderBrush="Black" BorderThickness="2" CornerRadius="25" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding UnconsciousRating, StringFormat='UnconsciousRating:     {0}'}" 
                                           FontSize="25" Padding="0 0 5 10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding DeathRating, StringFormat='DeathRating:               {0}'}" 
                                           FontSize="25" Padding="0 0 5 10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding WoundThreshold, StringFormat='WoundThreshold:         {0}'}" 
                                           FontSize="25" Padding="0 0 5 10"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="PrimaryDescriptionText" 
                                           Text="{Binding RecoveryTests, StringFormat='RecoveryTests:             {0}'}" 
                                           FontSize="25" Padding="0 0 5 10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
        <Border Classes="background" CornerRadius="30" Padding="0 0 0 10">
            <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
                       Classes="PrimaryText" 
                       Content="{Binding RemainingTalentPoints, StringFormat='{}Talent Points Remaining: {0}'}" 
                       VerticalAlignment="Top" HorizontalAlignment="Center" 
                       FontSize="30"></Label>
                <Grid Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" RowDefinitions="Auto, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="25, 25, 330, 60, 60">
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" 
                                   Classes="PrimaryDescriptionText"
                                   FontSize="25"
                                   HorizontalAlignment="Center"
                                   Text="Discipline Talent"></TextBlock>
                        <TextBlock Grid.Column="3" 
                                   Classes="PrimaryDescriptionText"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   Text="Rank"></TextBlock>
                        <TextBlock Grid.Column="4" 
                                   Classes="PrimaryDescriptionText"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   Text="Step"></TextBlock>
                    </Grid>
                    <ListBox Grid.Row="1"
                             Background="Transparent" Margin="0, 0, 0, 0" Padding="0"
                             ItemsSource="{Binding DisciplineTalents}" 
                             SelectedItem="{Binding SelectedCharacterTalent}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="25, 25, 330, 60, 60">
                                    <Button Grid.Column="0" Content="-"
                                            Command="{Binding $parent[ListBox].((vm:CharacterCustomizationsViewModel)DataContext).TalentDecreaseButtonClickedCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="1" Content="+"
                                            Command="{Binding $parent[ListBox].((vm:CharacterCustomizationsViewModel)DataContext).TalentIncreaseButtonClickedCommand}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Grid.Column="2" Classes="PrimaryDescriptionText" FontSize="20" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="3" Classes="PrimaryDescriptionText" HorizontalAlignment="Center" FontSize="20" Text="{Binding Rank}"/>
                                    <TextBlock Grid.Column="4" Classes="PrimaryDescriptionText" HorizontalAlignment="Center" FontSize="20" Text="{Binding Step}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Classes="PrimaryDescriptionText" Text="Selected Optional Talent" FontSize="25" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="-" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0 0 12 0"
                                Command="{Binding OptionalTalentDecreaseButtonClickedCommand}"
                                CommandParameter="{Binding SelectedOptionalTalent}"/>
                        <TextBlock Classes="PrimaryDescriptionText" Text="{Binding SelectedOptionalTalent}" FontSize="20" HorizontalAlignment="Left" Padding="5 0 0 0"/>
                        
                        <Button Content="+" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12 0 0 0 "
                                Command="{Binding OptionalTalentIncrementButtonClickedCommand}"
                                CommandParameter="{Binding SelectedOptionalTalent}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label Classes="PrimaryText" HorizontalAlignment="Center" FontSize="20" Content="Rank: "></Label>
                        <Label Classes="PrimaryText" HorizontalAlignment="Center" FontSize="20" Content="{Binding OptionalTalentRank}" Padding="0 3 20 0"/>
                        <Label Classes="PrimaryText" HorizontalAlignment="Center" FontSize="20" Content="Step: "></Label>
                        <Label Classes="PrimaryText" HorizontalAlignment="Center" FontSize="20" Content="{Binding OptionalTalentStep}" Padding="0 3 0 0"></Label>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <Label Classes="PrimaryText" Content="Discipline Free Talents" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="25" Padding="0 20 0 0"></Label>
                    <ListBox ItemsSource="{Binding FreeTalents}" Background="Transparent" HorizontalAlignment="Center">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Classes="PrimaryDescriptionText" FontSize="20" Text="{Binding Name}"/>
                                    <TextBlock Classes="PrimaryDescriptionText" FontSize="20" Text=" - Rank: " Padding="10 0 0 0"/>
                                    <TextBlock Classes="PrimaryDescriptionText" FontSize="20" Text="{Binding Rank}"/>
                                    <TextBlock Classes="PrimaryDescriptionText" FontSize="20" Text="   Step: " Padding="10 0 0 0"/>
                                    <TextBlock Classes="PrimaryDescriptionText" FontSize="20" Text="{Binding Step}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.RowSpan="2">
                    <TextBlock Classes="PrimaryDescriptionText" Text="Available Optional Talents:" FontSize="25"/>
                    <ItemsControl ItemsSource="{Binding OptionalTalents}" FontSize="20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Classes="PrimaryRadioButton"
                                    GroupName="NoviceOptionTalents"
                                    Content="{Binding}"
                                    Command="{Binding $parent[ItemsControl].((vm:CharacterCustomizationsViewModel)DataContext).SelectNoviceOptionTalentCommand}"
                                    CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
        <Border Classes="background" CornerRadius="30">
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="*, *">
                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="PrimarySubHeader" Content="Talent Description" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <Label Classes="PrimaryText" Content="{Binding  CurrentTalent.Name, TargetNullValue='No Value'}"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Classes="PrimaryText" Content="Governing Attribute:" Padding="10 5 5 0"/>
                        <TextBlock Classes="PrimaryDescriptionText" 
                                   Text="{Binding CurrentTalent.Step, TargetNullValue='No Value'}" 
                                   Padding="3 5 0 0"/>
                        <Label Classes="PrimaryText" Content="Strain:" Padding="75 5 5 0"/>
                        <TextBlock Classes="PrimaryDescriptionText" 
                                   Text="{Binding CurrentTalent.Strain, TargetNullValue='No Value'}" 
                                   Padding="3 5 0 0"/>
                        <Label Classes="PrimaryText" Content="Action:" Padding="75 5 5 0"/>
                        <TextBlock Classes="PrimaryDescriptionText" 
                                   Text="{Binding CurrentTalent.Action, TargetNullValue='No Value'}" 
                                   Padding="3 5 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
            
                    </StackPanel>
                    <Label Classes="PrimaryText" Content="Description:" Padding="10 5 5 1"/>
                    <TextBlock Classes="PrimaryDescriptionText" Text="{Binding CurrentTalent.Description, TargetNullValue='No Value'}" TextWrapping="Wrap" Padding="20 5 5 15"/>
                </StackPanel>
            </Grid>
        </Border>
        <Panel HorizontalAlignment="Center" VerticalAlignment="Bottom" >
            <Button Classes="TextureButton" 
                    Command="{Binding SaveAndContinueCommand}"
                    Content="Save &amp; Continue" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="24"
                    HorizontalAlignment="Center"
                    Height="64" Width="256"/>
        </Panel>
    </StackPanel>
</UserControl>
