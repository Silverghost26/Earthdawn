<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Earthdawn.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:EquipmentSelectionViewModel"
             x:Class="Earthdawn.Views.EquipmentSelectionView">
    
    <Design.DataContext>
        <vm:EquipmentSelectionViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="20">
            <Label Classes="PrimaryHeader" Content="Equipment Selection" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Equipment Carousel -->
            <Border Classes="background" BorderBrush="Black" BorderThickness="2" CornerRadius="10" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <Label Content="General Equipment" Classes="PrimarySubHeader" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <Carousel ItemsSource="{Binding EquipmentCards}" 
                              SelectedIndex="{Binding SelectedEquipmentIndex}"
                              Width="1800" Height="300">
                        <Carousel.PageTransition>
                            <PageSlide Duration="0:00:00.5" Orientation="Horizontal"/>
                        </Carousel.PageTransition>
                        <Carousel.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="15">
                                    <Grid ColumnDefinitions="250, *" RowDefinitions="Auto, *">
                                        <!-- Equipment Name Centered at the Top -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                                   Text="{Binding Name}" 
                                                   HorizontalAlignment="Center" 
                                                   FontSize="20" FontWeight="Bold" 
                                                   Margin="0,0,0,15"/>

                                        <!-- Equipment Properties in a Bordered Box on the Left Side -->
                                        <Border Grid.Column="0" Grid.Row="1" 
                                                BorderBrush="Black" BorderThickness="1" 
                                                CornerRadius="3" Padding="10" 
                                                Margin="0,0,15,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Equipment.type, StringFormat='Type: {0}'}" 
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Equipment.Availability, StringFormat='Availability: {0}'}" 
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Equipment.Cost, StringFormat='Cost: {0}'}" 
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Equipment.Weight, StringFormat='Weight: {0}'}" 
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Equipment.magical, StringFormat='Magical: {0}'}" 
                                                           Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Equipment.bloodCharm, StringFormat='Blood Charm: {0}'}" 
                                                           Margin="0,0,0,5"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Description Taking Up Remaining Space -->
                                        <StackPanel Grid.Column="1" Grid.Row="1">
                                            <TextBlock Text="Description:" 
                                                       FontWeight="Bold" 
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Equipment.Description}" 
                                                       TextWrapping="Wrap" 
                                                       MaxHeight="200"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </Carousel.ItemTemplate>
                    </Carousel>

                    <!-- Equipment Navigation Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,15,0,0">
                        <Button Content="Previous" 
                                Command="{Binding PreviousEquipmentCommand}"
                                Width="100" Height="35"/>
                        <Button Content="Select" 
                                Command="{Binding SelectEquipmentCommand}"
                                Width="100" Height="35"/>
                        <Button Content="Next" 
                                Command="{Binding NextEquipmentCommand}"
                                Width="100" Height="35"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
